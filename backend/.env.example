# GoldMind 后端环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置
#
# ⚠️ 这里只放**容器/进程内的应用**要读的变量。
#    `MYSQL_ROOT_PASSWORD` 之类的 compose 变量不在此处 ——
#    docker-compose 的变量插值只认宿主环境和**项目根目录**的 .env，
#    写在这里不会被读到（详见 README「方式二：Docker部署」）。

# ============================================
# 数据库配置
# ============================================
# 唯一真源：应用、init_db.py、seed_data.py、scripts/*.py 都从这里取。
# 本地开发用 localhost；Docker 部署时 compose 会用 mysql 主机名覆盖它，
# 所以这里填 localhost 即可，两种场景都对。
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/gold_analysis

# ============================================
# AI API 密钥配置
# ============================================
# 小米 MiMo —— 推理与联网搜索统一使用同一个 key。
# 获取地址: https://platform.xiaomimimo.com/
# 注意：Token Plan 套餐条款限定「仅可在编程工具中使用，禁止用于自定义应用
# 程序后端」。本项目以 tp- key 作为后端调用属于条款外用法，详见
# docs/00-产品方向.md 第四节。
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
# 如需改用按量付费的普通 API（合规做法）：
#   MIMO_BASE_URL=https://api.xiaomimimo.com/v1
#   并把 MIMO_API_KEY 换成 sk- 开头的 key。

# ============================================
# 应用配置
# ============================================
# 调试模式 (开发环境设为 true，生产环境设为 false)
DEBUG=true

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# 可选配置
# ============================================
# 缓存目录路径（留空则用 backend/cache）
# CACHE_DIR=./cache

# 是否让 httpx 读取宿主的代理环境变量（ALL_PROXY / HTTP_PROXY / NO_PROXY 等）。
# 默认 false。若你的网络必须经代理才能访问 MiMo，设为 true
# 并确保已安装 httpx[socks]。
# 注意：NO_PROXY 里写 `[::1]` 会让 httpx 解析失败，进而让所有 LLM 调用报错。
# MIMO_TRUST_ENV=false

# 新闻RSS源配置，格式 "名称|URL,名称|URL"（留空则使用内置默认源）
# NEWS_RSS_SOURCES=FXStreet|https://www.fxstreet.com/rss/news,CNBC Markets|https://www.cnbc.com/id/100003114/device/rss/rss.html
