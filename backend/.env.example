# GoldMind 后端环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置
#
# ⚠️ 这里只放**容器/进程内的应用**要读的变量。
#    `MYSQL_ROOT_PASSWORD` 之类的 compose 变量不在此处 ——
#    docker-compose 的变量插值只认宿主环境和**项目根目录**的 .env，
#    写在这里不会被读到（详见 README「方式二：Docker部署」）。

# ============================================
# 数据库配置
# ============================================
# 唯一真源：应用、init_db.py、seed_data.py、scripts/*.py 都从这里取。
# 本地开发用 localhost；Docker 部署时 compose 会用 mysql 主机名覆盖它，
# 所以这里填 localhost 即可，两种场景都对。
DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/gold_analysis

# ============================================
# LLM 接入（任何 OpenAI 兼容端点）
# ============================================
# 密钥、端点、模型三项必须**同时**填写，缺任意一项都算「未配置」——
# 各分析区块会如实显示「暂不可用」，不会退回任何内置内容。
#
# 常见供应商（任选其一，换成自己的 key；端点须兼容 OpenAI 协议）：
#   OpenAI        LLM_BASE_URL=https://api.openai.com/v1
#                 LLM_MODEL=gpt-4o-mini
#   DeepSeek      LLM_BASE_URL=https://api.deepseek.com/v1
#                 LLM_MODEL=deepseek-chat
#   通义千问       LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 LLM_MODEL=qwen-plus
#   Kimi          LLM_BASE_URL=https://api.moonshot.cn/v1
#                 LLM_MODEL=moonshot-v1-8k
#   Ollama（本地） LLM_BASE_URL=http://localhost:11434/v1
#                 LLM_MODEL=qwen2.5:14b
#   小米 MiMo      LLM_BASE_URL=https://api.xiaomimimo.com/v1
#                 LLM_MODEL=mimo-v2.6-flash
#
# ⚠️ 密钥只放这里（.env 已被 .gitignore 忽略），不要提交、不要贴进聊天或 issue。
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 仅用于界面展示的供应商标签，可留空（留空就只显示模型名）。
LLM_PROVIDER=

# 单次输出的 token 上限，默认 8192。推理类模型把思考与正文共用这份额度，
# 调得太小会让长 JSON（如三档投资策略）被截断、解析失败。截断可据
# 日志里的 finish_reason=length 判断。当前端点实测接受 8192。
# LLM_MAX_TOKENS=8192

# 是否让 httpx 读取宿主的代理环境变量（ALL_PROXY / HTTP_PROXY / NO_PROXY 等）。
# 默认 false。若你的网络必须经代理才能访问 LLM 端点，设为 true
# 并确保已安装 httpx[socks]（见 requirements.txt）。
# 注意：NO_PROXY 里写 `[::1]` 会让 httpx 解析失败，进而让所有 LLM 调用报错。
# LLM_TRUST_ENV=false

# ------------------------------------------------------------------
# 联网搜索（可选，默认关闭）
# ------------------------------------------------------------------
# 开启后使用「MiMo 插件式」的 web_search 工具（请求体里带 tools=[{...}]）。
# 这不是通用 OpenAI 能力：只有声明支持该工具的端点可用，且需在控制台
# 开通联网搜索插件。账号未开通时端点返回
#   HTTP 400 · web search tool found in the request body, but
#   webSearchEnabled is false
# 保持关闭时，分析直接走数据库 / RSS 新闻回退，不发起无效请求。
# LLM_SEARCH_ENABLED=false
# 搜索模型 / 端点 / 密钥：留空则跟随上面的 LLM_MODEL / LLM_BASE_URL / LLM_API_KEY
# （分开配置是为了支持「推理用低成本端点、搜索用另一端点」）。
# LLM_SEARCH_MODEL=
# LLM_SEARCH_BASE_URL=
# LLM_SEARCH_API_KEY=
# 单次搜索最大关键词数：每轮搜索会并发展开成多次插件调用、按次计费，
# 所以这是主要的成本控制旋钮。
# LLM_SEARCH_MAX_KEYWORD=2

# ============================================
# 应用配置
# ============================================
# 只影响 uvicorn 的 --reload（热重载）。
# 代码里的默认值是 false —— 没有 .env 时不该默认打开开发期的自动重载。
# 本地开发想要热重载就在这里写 true；docker-compose 会用 DEBUG=false 覆盖。
DEBUG=true

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# 可选配置
# ============================================
# 缓存目录路径（留空则用 backend/cache）
# CACHE_DIR=./cache

# 是否让 httpx 读取宿主的代理环境变量（ALL_PROXY / HTTP_PROXY / NO_PROXY 等）。
# 默认 false。若你的网络必须经代理才能访问 MiMo，设为 true
# 并确保已安装 httpx[socks]。
# 注意：NO_PROXY 里写 `[::1]` 会让 httpx 解析失败，进而让所有 LLM 调用报错。
# MIMO_TRUST_ENV=false

# 新闻RSS源配置，格式 "名称|URL,名称|URL"（留空则使用内置默认源）
# NEWS_RSS_SOURCES=FXStreet|https://www.fxstreet.com/rss/news,CNBC Markets|https://www.cnbc.com/id/100003114/device/rss/rss.html

# 机构观点的新闻扫描窗口（天），默认 30。机构观点取每家机构最近一次可核实的
# 预测（可以是窗口内较早发布的）；空目标价不会覆盖数据库里已有的真实记录。
# INSTITUTION_NEWS_LOOKBACK_DAYS=30
